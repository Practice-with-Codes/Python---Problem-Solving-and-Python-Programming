   "source": [
    "# AD_8: Function to Find the Maximum of Three Numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "6\n"
     ]
    }
   ],
   "source": [
    "def max_two(x, y):\n",
    "    if (x > y):\n",
    "        return x\n",
    "    return y\n",
    "def max_three(x, y, z):\n",
    "    return max_two(x, max_two(y, z))\n",
    "print(max_three(3, 6, -5))"
   ]
  }
 ],
