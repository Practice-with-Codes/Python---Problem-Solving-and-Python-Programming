   "source": [
    "# Program to calculate the sum of an array of numbers\n",
    "\n",
    "def listsum(numList):\n",
    "    if len(numList) == 1:\n",
    "        return numList[0]\n",
    "    else:\n",
    "        return numList[0] + listsum(numList[1:])\n",
    "print(listsum([1, 3, 5, 7, 9]))"
   ]
  }
